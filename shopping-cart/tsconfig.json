{
    "compilerOptions": {
        /* Базові налаштування */
        "target": "ES6", // На яку версію JS перетворювати код (ES6 підтримують усі сучасні браузери)
        "module": "ESNext", // Використовуємо сучасні модулі (import/export)
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES6"
        ], // Підключаємо типи для браузера (window, document, fetch)
        "allowJs": true, // Дозволяємо додавати звичайні .js файли, якщо треба
        /* Папки входу та виходу */
        "outDir": "./dist", // Куди збирати готові .js файли
        "rootDir": "./src", // Де лежать ваші початкові .ts файли
        /* Рівень строгості перевірок */
        "strict": true, // Вмикає всі строгі перевірки (включаючи strictNullChecks)
        "noImplicitAny": true, // Забороняє залишати типи як "any" без явного вказання
        "strictNullChecks": true, // Змушує перевіряти DOM-елементи на існування (if (container)
        "strictFunctionTypes": true, // Перевіряє типи функцій на сумісність
        "noUnusedLocals": true, // Попереджає про створені, але не використані змінні
        "noUnusedParameters": true, // Попереджає про невикористані аргументи у функціях
        "removeComments": false // Зберігати коментарі після компіляції (можна змінити на true)
    },
    "include": [
        "src/**/*"
    ] // Компілятор стежитиме лише за файлами всередині папки src
}